{
  "name": "@openasy/code-style",
  "version": "0.1.2",
  "description": "One code style for every OpenAsy repository: the Prettier and oxlint settings.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openasy/code-style.git"
  },
  "type": "module",
  "files": [
    "prettier.json",
    "oxlint.json"
  ],
  "exports": {
    "./prettier": "./prettier.json",
    "./oxlint.json": "./oxlint.json",
    "./package.json": "./package.json"
  },
  "prettier": "./prettier.json",
  "scripts": {
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "peerDependencies": {
    "oxlint": ">=1.87.0",
    "prettier": ">=3.9.9"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "prettier": "^3.9.9"
  }
}
